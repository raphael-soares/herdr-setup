{
  "global": {
    "ctrl-space ctrl-space": "send:\u0000",
    "ctrl-space c": "tab.new",
    "ctrl-space \"": "pane.split:down",
    "ctrl-space %": "pane.split:right",
    "ctrl-space h": "pane.go:left",
    "ctrl-space j": "pane.go:down",
    "ctrl-space k": "pane.go:up",
    "ctrl-space l": "pane.go:right",
    "ctrl-space ctrl-n": "tab.next",
    "ctrl-space ctrl-p": "tab.prev",
    "ctrl-space 1": "tab.select:1",
    "ctrl-space 2": "tab.select:2",
    "ctrl-space 3": "tab.select:3",
    "ctrl-space 4": "tab.select:4",
    "ctrl-space 5": "tab.select:5",
    "ctrl-space 6": "tab.select:6",
    "ctrl-space 7": "tab.select:7",
    "ctrl-space 8": "tab.select:8",
    "ctrl-space 9": "tab.select:9",
    "ctrl-space z": "pane.zoom",
    "ctrl-space x": "setup.close-pane",
    "ctrl-space &": "setup.close-tab",
    "ctrl-space shift-q": "setup.close-space",
    "ctrl-space s": "mod.open:picker",
    "ctrl-space w": "mod.open:picker",
    "ctrl-space e": "setup.sidebar",
    "ctrl-space ctrl-a": "agent.next",
    "ctrl-space ,": "app.settings",
    "ctrl-space tab": "setup.sessionizer",
    "ctrl-space shift-s": "setup.ssh",
    "ctrl-space o": "setup.back",
    "ctrl-space n": "setup.new",
    "ctrl-space g": "setup.worktree-new",
    "ctrl-space shift-g": "setup.worktree-open",
    "ctrl-space shift-x": "setup.worktree-remove",
    "ctrl-space t": "mod.open:auto-title",
    "ctrl-space a": "setup.automations"
  },
  "terminal": {
    "shift-pageup": { "command": "terminal.scroll", "args": { "pages": -0.5 } },
    "shift-pagedown": { "command": "terminal.scroll", "args": { "pages": 0.5 } },
    "ctrl-backspace": "send:\u0017",
    "ctrl-left": "send:\u001bb",
    "ctrl-right": "send:\u001bf",
    "ctrl-shift-c": "terminal.copy",
    "ctrl-shift-v": "terminal.paste",
    "ctrl-shift-f": "terminal.search",
    "ctrl-v": "terminal.paste_image",
    "ctrl-insert": "terminal.copy",
    "shift-insert": "terminal.paste"
  }
